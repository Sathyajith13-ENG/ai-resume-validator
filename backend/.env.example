PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Get free cluster at https://www.mongodb.com/atlas/database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resumevalidator?retryWrites=true&w=majority

# Google Gemini API Key
# Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS - set to your frontend URL in production
CORS_ORIGIN=http://localhost:5173

# Rate limiting (requests per 15 minutes per IP)
RATE_LIMIT_MAX=50
